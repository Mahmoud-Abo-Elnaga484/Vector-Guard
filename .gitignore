# Environment / secrets
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Qdrant local storage — rebuilt by `python main.py ingest` / 2_BUILD_INDEX.bat.
# Shipping this causes "already accessed by another instance" lock errors on
# machines that still have the old process/lock lingering.
src/assets/qdrant/*
!src/assets/qdrant/.gitkeep

# Evaluation output (regenerated by run_eval.py / 4_RUN_EVALUATION.bat)
src/evaluation/results/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
